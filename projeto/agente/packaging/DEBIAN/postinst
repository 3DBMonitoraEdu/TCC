#!/bin/sh
set -e

case "$1" in
  configure)
    # Permite que o agente de sessão (executado pelo aluno) possa gravar a configuração inicial
    if [ -d /etc/monitoredu ]; then
      chmod 0777 /etc/monitoredu
    fi
    if [ -f /etc/monitoredu/config.json ]; then
      chmod 0666 /etc/monitoredu/config.json
    fi

    # Recarrega e habilita o serviço no systemd se estiver ativo
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      systemctl enable monitoredu.service
      systemctl restart monitoredu.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0